# Server
PORT=5000
NODE_ENV=development

# Comma-separated list of origins allowed to call this API
FRONTEND_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://localhost:27017/portfolio

# Optional: email notification when a new contact message arrives.
# Leave blank to skip sending email — messages are still saved to MongoDB.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=true

# Required to read messages via GET /api/contact — pick any long random string
ADMIN_API_KEY=